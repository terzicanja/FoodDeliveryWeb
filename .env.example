# PostgreSQL connection string used by Prisma (see prisma.config.ts)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_delivery?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication (JWT)
# Use a long, random secret in production (e.g. `openssl rand -base64 32`)
JWT_SECRET="change-me-to-a-long-random-secret"
# Optional. Token lifetime accepted by jsonwebtoken (default: 7d)
JWT_EXPIRES_IN="7d"
# Optional. Auth cookie max-age in seconds (default: 604800 = 7 days)
JWT_MAX_AGE_SECONDS="604800"
